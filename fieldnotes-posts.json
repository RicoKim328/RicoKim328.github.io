---
layout: null
---
[
{% for post in site.posts %}
  {
    "id": {{ post.path | remove_first: '_posts/' | remove: '.md' | remove: '.markdown' | jsonify }},
    "title": {{ post.title | jsonify }},
    "category": {{ post.category | default: 'Notes' | jsonify }},
    "date": {{ post.date | date: '%Y-%m-%d' | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 140 | jsonify }},
    "format": "html",
    "content": {{ post.content | jsonify }},
    "source": {{ post.path | prepend: 'https://github.com/RicoKim328/RicoKim328.github.io/blob/main/' | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
